<div class="ba-page" data-ba-page="about" data-ba-active="about">
<header data-screen-label="About / Hero" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(64px, 10vw, 140px) clamp(16px, 5vw, 64px) clamp(48px, 7vw, 88px); display: flex; flex-direction: column; gap: 28px;">
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_about_us_payson_to_orem | escape }}</p>
<h1 class="ba-display" style="color: var(--on-band); font-size: min(clamp(48px, 8vw, 104px), 12vw); letter-spacing: -0.045em; line-height: 0.92; max-width: 12ch;">{{ section.settings.t_a_barbershop_first | escape }}</h1>
<p style="max-width: 620px; font-size: clamp(18px, 1.8vw, 22px); line-height: 1.6; opacity: 0.85; text-wrap: pretty;">{{ section.settings.t_broken_arrow_is_a_small_loca | escape }}</p>
</div>
<figure style="max-width: 1280px; margin: 0px auto; padding: 0px clamp(16px, 5vw, 64px) clamp(48px, 7vw, 88px); display: flex; flex-direction: column; gap: 12px;">
<img alt="Green walls and cognac barber chairs inside Broken Arrow Barbershop in Orem" loading="lazy" src="{{ img_shop_interior }}" style="width: 100%; aspect-ratio: 21 / 9; object-fit: cover; display: block;"/>
<figcaption style="font-size: 14px; line-height: 22px; opacity: 0.78;">{{ section.settings.t_the_orem_shop_today | escape }}</figcaption>
</figure></header><section data-screen-label="About / Intro" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 112px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 32px 48px;">
<p class="ba-label" style="flex: 1 1 220px;">{{ section.settings.t_who_we_are | escape }}</p>
<div style="flex: 2 1 520px; max-width: 720px; display: flex; flex-direction: column; gap: 24px;">
<p style="font-size: clamp(20px, 2vw, 24px); line-height: 1.55; text-wrap: pretty;">{{ section.settings.t_broken_arrow_was_founded_by_ | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_today_we_re_three_barbers_in | escape }}</p>
</div></section><section data-screen-label="About / 01 Payson" style="background: var(--canvas-sunk);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6vw, 80px); align-items: center;">
<figure style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 12px;">
<img alt="The original Broken Arrow Barbershop storefront on Main Street in Payson" loading="lazy" src="{{ img_payson_storefront }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<figcaption style="font-size: 14px; line-height: 22px; color: var(--ink-muted);">{{ section.settings.t_our_first_shop_5_n_main_pays | escape }}</figcaption>
</figure>
<div style="flex: 1 1 440px; max-width: 620px; display: flex; flex-direction: column; gap: 24px;">
<p class="ba-label">{{ section.settings.t_01_payson | escape }}</p>
<h2 class="ba-display" style="font-size: clamp(32px, 4vw, 48px); max-width: 14ch;">{{ section.settings.t_where_it_started | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_bryton_opened_broken_arrow_i | escape }}</p>
</div>
</div></section><figure data-screen-label="About / Payson photos" style="background: var(--canvas-sunk); margin: 0px;">
<div style="max-width: 1280px; margin: 0px auto; padding: 0px clamp(16px, 5vw, 64px) clamp(56px, 8vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 4px;">
<img alt="Waiting area of the Payson shop with guitars and leather chairs" loading="lazy" src="{{ img_payson_lounge }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<img alt="The Payson shop floor with a red barber chair" loading="lazy" src="{{ img_payson_floor }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<img alt="Skin fade with a slicked-back top and full beard, cut in Payson" loading="lazy" src="{{ img_payson_cut_pomp }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<img alt="Textured modern mullet with a taper, cut in Payson" loading="lazy" src="{{ img_payson_cut_mullet }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
</div></figure><section data-screen-label="About / 02 Teaching" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap-reverse; gap: 40px clamp(40px, 6vw, 80px); align-items: center;">
<div style="flex: 1 1 440px; max-width: 620px; display: flex; flex-direction: column; gap: 24px;">
<p class="ba-label">{{ section.settings.t_02_the_team | escape }}</p>
<h2 class="ba-display" style="font-size: clamp(32px, 4vw, 48px); max-width: 14ch;">{{ section.settings.t_trained_here | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_bryton_taught_hundreds_of_st | escape }}</p>
<a href="/pages/team" style="font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; align-self: flex-start;">{{ section.settings.t_meet_the_team | escape }}</a>
</div>
<figure style="flex: 1.2 1 460px; display: flex; flex-direction: column; gap: 12px;">
<img alt="Bryton teaching a class of barber students" loading="lazy" src="{{ img_bryton_teaching }}" style="width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block;"/>
<figcaption style="font-size: 14px; line-height: 22px; color: var(--ink-muted);">{{ section.settings.t_bryton_teaching_barbers | escape }}</figcaption>
</figure></section><section data-screen-label="About / 03 Orem" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6vw, 80px); align-items: center;">
<figure style="flex: 1.2 1 460px; display: flex; flex-direction: column; gap: 12px;">
<img alt="Wide view of Broken Arrow Barbershop in Orem" loading="lazy" src="{{ img_shop_wide }}" style="width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block;"/>
<figcaption style="font-size: 14px; line-height: 22px; opacity: 0.78;">{{ section.settings.t_375_e_800_s_suite_12_orem | escape }}</figcaption>
</figure>
<div style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 24px;">
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_03_orem | escape }}</p>
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(32px, 4vw, 48px); max-width: 14ch;">{{ section.settings.t_a_new_chapter | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; opacity: 0.85; text-wrap: pretty;">{{ section.settings.t_the_shop_moved_to_a_bigger_s | escape }}</p>
</div>
</div></section><section data-screen-label="About / 04 Hair loss" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6vw, 80px); align-items: center;">
<figure style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 12px;">
<img alt="Bryton fitting a hair system" loading="lazy" src="{{ img_bryton_hair_system }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<figcaption style="font-size: 14px; line-height: 22px; color: var(--ink-muted);">{{ section.settings.t_bryton_does_every_hair_syste | escape }}</figcaption>
</figure>
<div style="flex: 1 1 440px; max-width: 620px; display: flex; flex-direction: column; gap: 24px;">
<p class="ba-label">{{ section.settings.t_04_hair_loss | escape }}</p>
<h2 class="ba-display" style="font-size: clamp(32px, 4vw, 48px); max-width: 14ch;">{{ section.settings.t_more_than_haircuts | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_we_help_men_with_thinning_ha | escape }}</p>
<a href="/pages/hair-replacement" style="font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; align-self: flex-start;">{{ section.settings.t_hair_replacement | escape }}</a>
</div></section><figure data-screen-label="About / Work" style="margin: 0px; background: var(--canvas);">
<div style="max-width: 1280px; margin: 0px auto; padding: 0px clamp(16px, 5vw, 64px) clamp(56px, 8vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 4px;">
<img alt="A textured flow haircut" loading="lazy" src="{{ img_cut_textured_flow }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<img alt="A side part haircut" loading="lazy" src="{{ img_cut_side_part }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
<img alt="Curly hair with a taper" loading="lazy" src="{{ img_cut_curly_taper }}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;"/>
</div></figure><section data-screen-label="About / Story" style="background: var(--canvas-sunk);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px;">
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px;">
<p class="ba-label">{{ section.settings.t_the_full_story | escape }}</p>
<h2 class="ba-display" style="font-size: clamp(36px, 5vw, 64px); max-width: 14ch;">{{ section.settings.t_from_payson_to_orem | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_how_a_small_shop_in_payson_b | escape }}</p>
</div>
<a class="ba-btn ba-btn-secondary" href="/pages/broken-arrow-barbershop-story">{{ section.settings.t_read_our_story | escape }}</a>
</div></section><section data-screen-label="About / Book band" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px;">
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(48px, 7vw, 88px); max-width: 8ch;">{{ section.settings.t_book_a_haircut | escape }}</h2>
<a class="ba-btn ba-btn-primary ba-on-dark" href="https://book.squareup.com/appointments/a9bstwwcb18jn4/location/LFBJAQ8MMHY0Z/services">{{ section.settings.t_book_now | escape }}</a>
</div></section>
</div>
