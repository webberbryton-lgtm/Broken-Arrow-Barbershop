<span class="ba-label" style="background: var(--canvas); padding: 6px 10px;">{{ section.settings.t_out_of_stock | escape }}</span>
</div>
</a>
<div style="display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--line); padding-top: 14px;">
<p class="ba-label" style="color: var(--ink-muted);">{{ section.settings.t_grooming_2 | escape }}</p>
