{%- comment -%} Generated from the Claude Design page "Terms of Service". {%- endcomment -%}
<style>
.ba-page[data-ba-page="terms-of-service"] :is(ul) { margin: 0; }
</style>
<div class="ba-page" data-ba-page="terms-of-service">
<section data-screen-label="Info / Header" style="background: var(--canvas-sunk); border-bottom: 1px solid var(--line);">
<div style="max-width: 920px; margin: 0px auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 16px;">
<p class="ba-label">{{ section.settings.t_legal | escape }}</p>
<h1 class="ba-display" style="font-size: min(clamp(44px, 6.4vw, 80px), 11vw); letter-spacing: -0.045em;">{{ section.settings.t_terms_of_service | escape }}</h1>
<p class="ba-label" style="color: var(--ink-muted);">{{ section.settings.t_last_updated_september_26_20 | escape }}</p>
</div></section><article data-screen-label="Info / Body" style="max-width: 920px; margin: 0px auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 40px;">
<p style="font-size: clamp(19px, 1.9vw, 22px); line-height: 1.6; text-wrap: pretty;">{{ section.settings.t_these_terms_of_service_terms | escape }}</p>
<section style="display: flex; flex-direction: column; gap: 14px; border-top: 2px solid var(--ink); padding-top: 24px;">
<h2 style="font: 800 clamp(22px,2.4vw,28px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_1_general_terms | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_you_may_use_our_website_and_ | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_we_reserve_the_right_to_refu | escape }}</p>
</section>
<section style="display: flex; flex-direction: column; gap: 14px; border-top: 2px solid var(--ink); padding-top: 24px;">
<h2 style="font: 800 clamp(22px,2.4vw,28px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_2_appointments_and_barbering | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_appointments_may_be_booked_t | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_appointment_availability_is_ | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_clients_should_arrive_on_tim | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_haircuts_beard_services_styl | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_results_vary_depending_on_ha | escape }}</p>
</section>
<div style="display: flex; flex-direction: column; gap: 8px; background: var(--canvas-sunk); padding: 24px;">
<p class="ba-label">{{ section.settings.t_contact_us | escape }}</p>
<p style="font-size: 17px; line-height: 28px;">{{ section.settings.t_broken_arrow_barbershop_375_ | escape }}</p>
<p style="font-size: 17px; line-height: 28px;"><a href="tel:+18017091280">{{ section.settings.t_801_709_1280 | escape }}</a> · <a href="mailto:brokenarrowbarbershoporem@gmail.com">{{ section.settings.t_brokenarrowbarbershoporem_gm | escape }}</a></p>
</div></article>
</div>
