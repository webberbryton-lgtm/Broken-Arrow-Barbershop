<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px;">
<div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px; max-width: 560px;">
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_be_the_first_to_know | escape }}</p>
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(40px, 5.6vw, 72px);">{{ section.settings.t_get_notified_2 | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; opacity: 0.85;">{{ section.settings.t_we_ll_email_you_when_courses | escape }}</p>
</div>
<p class="ba-label" data-ba-done="" hidden="" style="color:var(--on-band)">{{ section.settings.t_you_re_on_the_list | escape }}</p><form data-ba-form="education-notify" novalidate="" style="flex: 1 1 380px; max-width: 520px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start;">
<input aria-label="Email" name="email" placeholder="Email address" style="flex: 1 1 240px; min-height: 56px; padding: 0px 16px; background: var(--canvas); color: var(--ink); border: 1px solid var(--line-strong); border-radius: 2px; font: 400 17px/24px var(--font-sans);" type="email" value=""/>
<button class="ba-btn ba-btn-primary ba-on-dark" type="submit">NOTIFY ME</button>
</form>
</div></section><section data-screen-label="Education / Apprenticeship" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px;">
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px;">
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_apprenticeship_no_current_op | escape }}</p>
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(40px, 5.6vw, 72px);">{{ section.settings.t_train_to_hire_hire_to_train | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; opacity: 0.85; text-wrap: pretty;">{{ section.settings.t_we_train_a_few_apprentices_t | escape }}</p>
</div>
<a class="ba-btn ba-btn-primary ba-on-dark" href="/pages/apprenticeship">{{ section.settings.t_about_the_apprenticeship | escape }}</a>
</div></section>
