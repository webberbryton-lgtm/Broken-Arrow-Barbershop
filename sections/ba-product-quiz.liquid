{%- comment -%} Generated from the Claude Design page "Product Quiz". {%- endcomment -%}
{%- liquid
if section.settings.img_clay_hero != blank
  assign img_clay_hero = section.settings.img_clay_hero | image_url: width: 2400
else
  assign img_clay_hero = 'ba-clay-hero.webp' | asset_url
endif
-%}
<style>
.ba-page[data-ba-page="product-quiz"] :is(ul, ol) { margin: 0; }
.ba-pq-link:hover { color: var(--green) !important; }
.ba-pq-opt:hover { border-color: var(--ink) !important; }
</style>
<div class="ba-page" data-ba-page="product-quiz" data-ba-active="quiz">
<section data-ba-pq-start="" data-screen-label="Quiz / Start" style="position: relative; background: var(--band); color: var(--on-band); min-height: clamp(520px, 76vh, 760px); display: flex; align-items: center; overflow: hidden;">
<img alt="" loading="lazy" src="{{ img_clay_hero }}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: 70% center;"/>
<div style="position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(22, 23, 26, 0.9) 0%, rgba(22, 23, 26, 0.65) 42%, rgba(22, 23, 26, 0.1) 75%);"></div>
<div style="position: relative; width: 100%; max-width: 1280px; margin: 0px auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 28px;">
<p class="ba-label" style="color: var(--on-band);">{{ section.settings.t_find_your_product_5_question | escape }}</p>
<h1 class="ba-display" style="color: var(--on-band); font-size: min(clamp(48px, 7vw, 92px), 11vw); letter-spacing: -0.045em; line-height: 0.92; max-width: 11ch;">{{ section.settings.t_what_does_your_hair_actually | escape }}</h1>
<p style="max-width: 460px; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.6; opacity: 0.9; text-wrap: pretty;">{{ section.settings.t_answer_a_few_quick_questions | escape }}</p>
<div><button class="ba-btn ba-btn-primary ba-on-dark" data-ba-pq-begin="" type="button">{{ section.settings.t_find_my_product | escape }}</button></div>
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_good_grooming_starts_with_be | escape }}</p>
</div></section><div data-ba-product-quiz="" data-img-clay="{{ 'ba-clay-card.webp' | asset_url }}" data-img-cream="{{ 'ba-cream-card.webp' | asset_url }}" data-img-salt="{{ 'ba-salt-card.webp' | asset_url }}"></div>
</div>
<script src="{{ 'ba-product-quiz.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Product Quiz",
  "tag": "div",
  "class": "ba-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "img_clay_hero",
      "label": "Quiz / Start — photo (clay-hero.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "header",
      "content": "Text: Quiz / Start"
    },
    {
      "type": "text",
      "id": "t_find_your_product_5_question",
      "label": "Quiz / Start — Text: Find your product · 5 questions · 30 sec",
      "default": "Find your product · 5 questions · 30 seconds"
    },
    {
      "type": "text",
      "id": "t_what_does_your_hair_actually",
      "label": "Quiz / Start — Heading: What does your hair actually need?",
      "default": "What does your hair actually need?"
    },
    {
      "type": "text",
      "id": "t_answer_a_few_quick_questions",
      "label": "Quiz / Start — Text: Answer a few quick questions and we’ll m",
      "default": "Answer a few quick questions and we’ll match you with the right Broken Arrow product."
    },
    {
      "type": "text",
      "id": "t_find_my_product",
      "label": "Quiz / Start — Text: FIND MY PRODUCT",
      "default": "FIND MY PRODUCT"
    },
    {
      "type": "text",
      "id": "t_good_grooming_starts_with_be",
      "label": "Quiz / Start — Text: Good grooming starts with being understo",
      "default": "Good grooming starts with being understood."
    }
  ]
}
{% endschema %}
