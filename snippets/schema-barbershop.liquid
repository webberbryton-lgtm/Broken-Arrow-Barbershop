{%- comment -%}
  Broken Arrow Barbershop: local business schema.
  Install: in layout/theme.liquid, inside <head>, add:
    {%- if template == 'index' -%}{% render 'schema-barbershop' %}{%- endif -%}
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BarberShop",
  "@id": "{{ shop.url }}/#barbershop",
  "name": "Broken Arrow Barbershop",
  "url": "{{ shop.url }}",
  "telephone": "+1-801-709-1280",
  "image": "{{ 'ba-shop-interior.webp' | asset_url }}",
  "logo": "{{ 'ba-mark.png' | asset_url }}",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "375 E 800 S, Suite 12",
    "addressLocality": "Orem",
    "addressRegion": "UT",
    "postalCode": "84097",
    "addressCountry": "US"
  },
  "areaServed": ["Orem", "Provo", "Utah County", "Utah Valley"],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "10:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Wednesday", "Thursday", "Friday"], "opens": "10:00", "closes": "19:30" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "17:30" }
  ],
  "sameAs": ["https://www.instagram.com/broken.arrow.barbershop/"],
  "award": "Daily Herald Readers' Choice, Best Barbershop in Utah Valley (2023, 2024, 2026)",
  "founder": { "@type": "Person", "name": "Bryton", "jobTitle": "Owner & licensed barber instructor" },
  "employee": [
    { "@type": "Person", "name": "Bryton", "url": "{{ shop.url }}/pages/bryton" },
    { "@type": "Person", "name": "Connor", "url": "{{ shop.url }}/pages/connor" },
    { "@type": "Person", "name": "Elise", "url": "{{ shop.url }}/pages/elise" }
  ],
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Classic Haircut" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Signature Haircut" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Haircut + Beard" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Hair replacement (hair systems)" } }
  ],
  "potentialAction": {
    "@type": "ReserveAction",
    "target": "https://book.squareup.com/appointments/vmqe6cigusj6yl/location/LFBJAQ8MMHY0Z/services",
    "name": "Book now"
  }
}
</script>
