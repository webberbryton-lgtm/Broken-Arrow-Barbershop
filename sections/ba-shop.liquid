<img alt="A barber working shampoo through a client’s hair with a scalp brush at the shop sink" loading="lazy" src="{{ img_wash_brush }}" style="flex: 1 1 420px; min-width: 0px; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 40%; display: block;"/>
