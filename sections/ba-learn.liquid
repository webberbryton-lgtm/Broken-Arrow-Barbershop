      "default": "How much matte clay to use"
    },
    {
      "type": "text",
      "id": "t_less_than_you_think_a_finger",
      "label": "Learn / Grid — Text: Less than you think. A fingertip, dry ha",
      "default": "Less than you think. A fingertip, dry hair, back to front."
    },
    {
      "type": "text",
      "id": "t_product_how_to_3_min_2",
      "label": "Learn / Grid — Text: Product how-to · 3 min",
      "default": "Product how-to · 3 min"
    },
    {
      "type": "text",
      "id": "t_clay_or_cream_which_one_is_f",
      "label": "Learn / Grid — Subheading: Clay or cream: which one is for you?",
      "default": "Clay or cream: which one is for you?"
    },
    {
      "type": "text",
      "id": "t_hold_finish_and_hair_length_",
      "label": "Learn / Grid — Text: Hold, finish and hair length, side by si",
      "default": "Hold, finish and hair length, side by side."
    },
    {
      "type": "header",
      "content": "Text: Learn / Quiz band"
    },
    {
      "type": "text",
      "id": "t_not_sure_what_to_use",
      "label": "Learn / Quiz band — Text: Not sure what to use?",
      "default": "Not sure what to use?"
    },
    {
      "type": "text",
      "id": "t_take_the_product_quiz",
      "label": "Learn / Quiz band — Heading: Take the product quiz.",
      "default": "Take the product quiz."
    },
    {
      "type": "text",
      "id": "t_start_the_quiz",
      "label": "Learn / Quiz band — Link text: START THE QUIZ",
      "default": "START THE QUIZ"
    }
  ]
}
{% endschema %}
