<div><a class="ba-btn ba-btn-primary ba-on-dark" href="https://book.squareup.com/appointments/cnl05yngyr8vhx/location/LFBJAQ8MMHY0Z/services">{{ section.settings.t_book_with_connor | escape }}</a></div>
</div>
</div>
</div></section><section data-screen-label="Barber / YouTube" style="background: var(--green); color: var(--on-band);">
