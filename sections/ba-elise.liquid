<span style="display: flex; flex-direction: column; gap: 6px;"><span style="font: 800 clamp(28px,3vw,36px)/1 var(--font-display); letter-spacing: -0.03em; text-transform: uppercase;">{{ section.settings.t_bryton | escape }}</span><span class="ba-label" style="color: var(--ink-muted);">{{ section.settings.t_owner_licensed_barber_instru | escape }}</span></span>
<span class="ba-label">{{ section.settings.t_view | escape }}</span>
</a>
<a class="bah-elise-1" href="/pages/connor" style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 24px 0px; border-top: 2px solid var(--ink); text-decoration: none; color: var(--ink);">
<span style="display: flex; flex-direction: column; gap: 6px;"><span style="font: 800 clamp(28px,3vw,36px)/1 var(--font-display); letter-spacing: -0.03em; text-transform: uppercase;">{{ section.settings.t_connor | escape }}</span><span class="ba-label" style="color: var(--ink-muted);">{{ section.settings.t_barber_2 | escape }}</span></span>
