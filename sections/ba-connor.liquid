<p style="font: 800 clamp(20px,2.2vw,26px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; text-wrap: pretty;">{{ section.settings.t_medium_length_cuts_that_stil | escape }}</p>
