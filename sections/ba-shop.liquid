{% schema %}
{
  "name": "Shop",
  "tag": "div",
  "class": "ba-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "img_clay_hero",
      "label": "Shop / Hero — photo (clay-hero.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_clay_card",
      "label": "Shop / Grid — photo (clay-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_cream_card",
      "label": "Shop / Grid — photo (cream-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_salt_card",
      "label": "Shop / Grid — photo (salt-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_shampoo_card",
      "label": "Shop / Grid — photo (shampoo-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_conditioner_card",
      "label": "Shop / Grid — photo (conditioner-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_aftershave_card",
      "label": "Shop / Grid — photo (aftershave-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_refuge_card",
      "label": "Shop / Grid — photo (refuge-card.png)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "image_picker",
      "id": "img_wash_brush",
      "label": "Shop / Developed by barbers — photo (wash-brush.jpg)",
      "info": "Leave empty to use the built-in photo."
    },
    {
      "type": "header",
      "content": "Text: Shop / Hero"
    },
    {
      "type": "text",
      "id": "t_broken_arrow_grooming_first_",
      "label": "Shop / Hero — Text: Broken Arrow Grooming · First product",
      "default": "Broken Arrow Grooming · First product"
    },
    {
      "type": "text",
      "id": "t_the_clay_we_use_in_the_chair",
      "label": "Shop / Hero — Heading: The clay we use in the chair.",
      "default": "The clay we use in the chair."
    },
    {
      "type": "textarea",
      "id": "t_matte_clay_firm_hold_no_shin",
      "label": "Shop / Hero — Text: Matte clay. Firm hold, no shine, washes ",
      "default": "Matte clay. Firm hold, no shine, washes out clean. Coming soon to order online or pick up at the shop."
    },
    {
      "type": "text",
      "id": "t_see_the_clay",
      "label": "Shop / Hero — Link text: SEE THE CLAY",
      "default": "SEE THE CLAY"
    },
