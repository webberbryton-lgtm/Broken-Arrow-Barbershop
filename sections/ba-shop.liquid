<p style="font:600 17px/28px var(--font-sans);font-variant-numeric:tabular-nums;white-space:nowrap">{{ section.settings.t_28 | escape }}</p>
</div>
<p style="font-size: 14px; line-height: 22px; color: var(--ink-muted);">{{ section.settings.t_firm_hold_no_shine_what_we_s | escape }}</p>
</div>
</article>
<article data-ba-cat="grooming" id="cream" style="display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 140px;">
<a aria-label="Styling cream" href="#shop" style="position: relative; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 5; background: var(--canvas-sunk); padding: 16px; text-decoration: none; overflow: hidden;">
