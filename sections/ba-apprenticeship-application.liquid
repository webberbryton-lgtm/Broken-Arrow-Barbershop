{%- comment -%} Generated from the Claude Design page "Apprenticeship Application". {%- endcomment -%}
<style>
.ba-page[data-ba-page="apprenticeship-application"] :is(ul) { margin: 0; }
</style>
<div class="ba-page" data-ba-page="apprenticeship-application" data-ba-active="apprenticeship">
<section data-screen-label="Application / Hero" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 24px;">
<nav aria-label="Breadcrumb" style="display: flex; gap: 10px; font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase;"><a href="/pages/apprenticeship" style="color: var(--on-band); opacity: 0.78; text-decoration: none;">{{ section.settings.t_apprenticeship | escape }}</a><span style="opacity: 0.5;">/</span><span>{{ section.settings.t_apply | escape }}</span></nav>
<h1 class="ba-display" style="color: var(--on-band); font-size: min(clamp(52px, 8vw, 112px), 11vw); letter-spacing: -0.045em; line-height: 0.92; max-width: 12ch;">{{ section.settings.t_we_hire_for_character_we_tra | escape }}</h1>
<p style="max-width: 620px; font-size: clamp(18px, 1.8vw, 22px); line-height: 1.6; text-wrap: pretty;">You do <strong>not</strong> need any haircutting experience to apply to the Broken Arrow Apprenticeship.</p>
<p class="ba-label" style="color: var(--on-band); border-top: 1px solid var(--line-strong); padding-top: 16px; max-width: 620px;">{{ section.settings.t_every_barber_in_our_shop_tod | escape }}</p>
<div><a class="ba-btn ba-btn-primary ba-on-dark" href="#apply">{{ section.settings.t_start_your_application | escape }}</a></div>
</div></section><section data-screen-label="Application / Character" style="max-width: 920px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 20px;">
<p style="font-size: clamp(19px, 1.9vw, 22px); line-height: 1.6; text-wrap: pretty;">{{ section.settings.t_we_can_teach_you_how_to_cut_ | escape }}</p>
<p class="ba-display" style="font-size: clamp(32px, 4vw, 52px); line-height: 1; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); padding: 28px 0px;">{{ section.settings.t_what_we_can_t_teach_is_chara | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_we_re_looking_for_people_who | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_at_broken_arrow_we_d_rather_ | escape }}</p></section><section data-screen-label="Application / What we look for" style="background: var(--canvas-sunk);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 32px 48px;">
<div style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px;"><p class="ba-label">{{ section.settings.t_01_character | escape }}</p><h2 class="ba-display" style="font-size: clamp(40px, 5vw, 64px); max-width: 10ch;">{{ section.settings.t_what_we_look_for | escape }}</h2></div>
<div style="flex: 2 1 520px; min-width: 0px; max-width: 760px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 0px 32px; border-top: 2px solid var(--ink);">
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_work_ethic | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_you_show_up_put_in_the_work_ | escape }}</p></div>
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_character | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_you_re_honest_responsible_re | escape }}</p></div>
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_people_skills | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_you_don_t_have_to_be_the_mos | escape }}</p></div>
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_coachability | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_you_can_take_correction_with | escape }}</p></div>
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_reliability | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_if_you_say_you_re_going_to_b | escape }}</p></div>
<div style="display: flex; flex-direction: column; gap: 8px; padding: 24px 0px; border-bottom: 1px solid var(--line);"><h3 style="font: 800 22px/26px var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_drive | escape }}</h3><p style="font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_you_actually_want_to_become_ | escape }}</p></div>
</div>
</div></section><section data-screen-label="Application / Not required" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 32px 48px;">
<div style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px;"><p class="ba-label">{{ section.settings.t_02_experience | escape }}</p><h2 class="ba-display" style="font-size: clamp(40px, 5vw, 64px); max-width: 10ch;">{{ section.settings.t_what_we_don_t_require | escape }}</h2></div>
<div style="flex: 2 1 520px; max-width: 760px; display: flex; flex-direction: column; gap: 20px; border-top: 2px solid var(--ink); padding-top: 28px;">
<p style="font: 800 clamp(24px,2.6vw,32px)/1.1 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_previous_haircutting_experie | escape }}</p>
<p style="font-size: 17px; line-height: 28px;">{{ section.settings.t_never_held_clippers_before_t | escape }}</p>
<p style="font-size: 17px; line-height: 28px; text-wrap: pretty;">{{ section.settings.t_our_job_is_to_teach_you_the_ | escape }}</p>
<p class="ba-display" style="font-size: clamp(28px, 3.4vw, 44px); line-height: 1; color: var(--green);">{{ section.settings.t_hire_for_character_train_for | escape }}</p>
</div></section><section data-screen-label="Apprenticeship / Apply" id="apply" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px 64px;">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 20px; max-width: 480px;">
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_03_apply | escape }}</p>
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(40px, 5.6vw, 72px);">{{ section.settings.t_apply_like_it_s_a_job_becaus | escape }}</h2>
<p style="font-size: 17px; line-height: 28px; opacity: 0.85; text-wrap: pretty;">{{ section.settings.t_we_don_t_have_any_apprentice | escape }}</p>
<div data-m-price="" style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; border-top: 1px solid var(--line-strong); padding-top: 20px;">
<span style="font:800 clamp(44px,5vw,64px)/1 var(--font-display);letter-spacing:-.03em;font-variant-numeric:tabular-nums;color:var(--on-band)">{{ section.settings.t_4_995 | escape }}</span>
<span class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_program_fee_vs_around_20_000 | escape }}</span>
</div>
<p class="ba-label" style="color: var(--on-band); border: 1px solid var(--line-strong); padding: 12px 16px; align-self: flex-start;">{{ section.settings.t_no_current_openings_please_s | escape }}</p>
</div>
<div style="flex: 1.3 1 420px; max-width: 720px; background: var(--canvas); color: var(--ink); padding: clamp(24px, 3vw, 40px);">
<div data-ba-done="" hidden="" style="display:flex;flex-direction:column;gap:12px"><p class="ba-label">{{ section.settings.t_application_received | escape }}</p><p style="font-size:17px;line-height:28px">Thanks, <span data-ba-first="">{{ section.settings.t_there | escape }}</span>. We’ll keep your application on file and reach out when an apprenticeship opens.</p></div><form data-ba-form="apprenticeship" novalidate="" style="display: flex; flex-direction: column; gap: 22px;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 22px;">
<div class="ba-field"><label class="ba-field-label" for="ba-f1">Full name<span aria-hidden="true" class="ba-field-req">*</span></label><input class="ba-field-input" id="ba-f1" name="name" required="" value=""/></div>
<div class="ba-field"><label class="ba-field-label" for="ba-f2">Phone<span aria-hidden="true" class="ba-field-req">*</span></label><input class="ba-field-input" id="ba-f2" name="phone" required="" type="tel" value=""/></div>
<div class="ba-field"><label class="ba-field-label" for="ba-f3">Email<span aria-hidden="true" class="ba-field-req">*</span></label><input class="ba-field-input" id="ba-f3" name="email" required="" type="email" value=""/></div>
<div class="ba-field"><label class="ba-field-label" for="ba-f4">City<span aria-hidden="true" class="ba-field-req">*</span></label><input class="ba-field-input" id="ba-f4" name="city" required="" value=""/></div>
</div>
<div class="ba-field"><label class="ba-field-label" for="ba-f5">Why do you want to be a barber?<span aria-hidden="true" class="ba-field-req">*</span></label><textarea class="ba-field-input" id="ba-f5" name="why" required=""></textarea></div>
<div class="ba-field"><label class="ba-field-label" for="ba-f6">Instagram (optional)</label><input class="ba-field-input" id="ba-f6" name="ig" value=""/></div>
<label class="ba-check"><input name="commit" type="checkbox"/><span aria-hidden="true" class="ba-check-box"></span><span>I understand the goal of this apprenticeship is to work at Broken Arrow after I’m licensed. *</span></label>
<button class="ba-btn ba-btn-primary" style="width: 100%;" type="submit">SUBMIT APPLICATION</button>
</form>
</div>
</div></section>
</div>
<script src="{{ 'ba-form-kit.js' | asset_url }}" defer></script>
<script src="{{ 'ba-apprenticeship.js' | asset_url }}" defer></script>
