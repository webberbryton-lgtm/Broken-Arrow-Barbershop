<style>
.ba-page[data-ba-page="elise"] :is(ul) { margin: 0; }
.bah-elise-1:hover { color: var(--green) !important; }
.ba-avail-hero:hover { color: var(--on-band) !important; border-color: var(--on-band) !important; }
</style>
<div class="ba-page" data-ba-page="elise" data-ba-active="team" data-ba-book="https://book.squareup.com/appointments/wkoxhle5mmhzak/location/LFBJAQ8MMHY0Z/services" data-ba-book-label="BOOK WITH ELISE" data-ba-barber="elise">
<section data-screen-label="Barber / Hero" style="background: var(--band); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(48px, 7vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6vw, 80px); align-items: flex-end;">
<div style="position: relative; overflow: hidden; flex: 1 1 360px; aspect-ratio: 4 / 5; background: rgb(34, 35, 38); display: flex; align-items: flex-end; padding: 16px;">
<div aria-label="Elise fading the back of a client’s haircut with clippers at Broken Arrow Barbershop" role="img" style='position: absolute; inset: 0px; background-image: url("{{ img_elise_profile }}"); background-size: cover; background-position: center center;'></div>
</div>
<div style="flex: 1.1 1 440px; display: flex; flex-direction: column; gap: 24px;">
<nav aria-label="Breadcrumb" style="display: flex; gap: 10px; font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase;">
<a href="/pages/team" style="color: var(--on-band); opacity: 0.78; text-decoration: none;">{{ section.settings.t_the_team | escape }}</a><span style="opacity: 0.5;">/</span><span>{{ section.settings.t_elise | escape }}</span>
</nav>
<h1 class="ba-display" style="color: var(--on-band); font-size: min(clamp(64px, 10vw, 140px), 11vw); letter-spacing: -0.045em; line-height: 0.88;">{{ section.settings.t_elise_2 | escape }}</h1>
<p class="ba-label" style="color: var(--on-band);">{{ section.settings.t_barber | escape }}</p>
<p data-ba-dynamic="" data-ba-years="years" style="max-width: 560px; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.7; opacity: 0.85; text-wrap: pretty;">Elise has been cutting hair since September 2023, so she has 3 years of experience. She specializes in medium-length styles and curly hair, and she likes flow cuts and longer, natural looks. Her cuts are clean and detailed. She takes the time to understand what you want and how you actually style your hair day to day, so the cut works with your routine. If you’re not sure what you want, she’ll help you figure it out. She also loves teaching clients how to style their hair at home, because styling makes or breaks a haircut.</p>
<div data-ba-avail-slot="elise" style="display: flex; flex-direction: column; gap: 16px; padding-top: 8px;">
<div><a class="ba-btn ba-btn-primary ba-on-dark" href="https://book.squareup.com/appointments/wkoxhle5mmhzak/location/LFBJAQ8MMHY0Z/services">{{ section.settings.t_book_with_elise | escape }}</a></div>
</div>
</div>
</div></section><section data-screen-label="Barber / YouTube" style="background: var(--green); color: var(--on-band);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(48px, 6vw, 80px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 48px;">
<div style="flex: 1 1 480px; max-width: 760px; display: flex; flex-direction: column; gap: 16px;">
<p class="ba-label" style="color: var(--on-band);">{{ section.settings.t_filmed_for_youtube_applicati | escape }}</p>
<h2 class="ba-display" style="color: var(--on-band); font-size: clamp(44px, 6vw, 80px); letter-spacing: -0.045em; max-width: 14ch;">{{ section.settings.t_apply_for_a_free_haircut | escape }}</h2>
<p style="font-size: 18px; line-height: 30px; color: var(--on-band); text-wrap: pretty;">{{ section.settings.t_no_charge_elise_films_transf | escape }}</p>
</div>
<a class="ba-btn ba-btn-secondary ba-on-dark" href="/pages/free-haircut">{{ section.settings.t_apply_for_a_free_cut | escape }}</a>
</div></section><div aria-label="Elise cutting a skin fade at her chair, the shop’s green wall behind her" data-screen-label="Barber / Wide photo" role="img" style='width: 100%; aspect-ratio: 2 / 1; max-height: 720px; background-color: var(--band); background-image: url("{{ img_elise_wide }}"); background-size: cover; background-position: center center;'></div><section data-screen-label="Barber / Book for" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 32px 48px;">
<p class="ba-label" style="flex: 1 1 220px;">{{ section.settings.t_01_book_elise_for | escape }}</p>
<ul style="flex: 2 1 520px; max-width: 760px; list-style: none; padding: 0px; display: flex; flex-direction: column; border-top: 2px solid var(--ink);">
<li style="display: grid; grid-template-columns: 56px minmax(0px, 1fr); gap: 16px; padding: 24px 0px; border-bottom: 1px solid var(--line);">
<span class="ba-label" style="padding-top: 6px;">{{ section.settings.t_01 | escape }}</span>
<p style="font: 800 clamp(20px,2.2vw,26px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; text-wrap: pretty;">{{ section.settings.t_curly_hair | escape }}</p>
</li>
<li style="display: grid; grid-template-columns: 56px minmax(0px, 1fr); gap: 16px; padding: 24px 0px; border-bottom: 1px solid var(--line);">
<span class="ba-label" style="padding-top: 6px;">{{ section.settings.t_02 | escape }}</span>
<p style="font: 800 clamp(20px,2.2vw,26px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; text-wrap: pretty;">{{ section.settings.t_medium_length_and_flow_cuts | escape }}</p>
</li>
<li style="display: grid; grid-template-columns: 56px minmax(0px, 1fr); gap: 16px; padding: 24px 0px; border-bottom: 1px solid var(--line);">
<span class="ba-label" style="padding-top: 6px;">{{ section.settings.t_03 | escape }}</span>
<p style="font: 800 clamp(20px,2.2vw,26px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; text-wrap: pretty;">{{ section.settings.t_help_finding_a_style_that_fi | escape }}</p>
</li>
<li style="display: grid; grid-template-columns: 56px minmax(0px, 1fr); gap: 16px; padding: 24px 0px; border-bottom: 1px solid var(--line);">
<span class="ba-label" style="padding-top: 6px;">{{ section.settings.t_04 | escape }}</span>
<p style="font: 800 clamp(20px,2.2vw,26px)/1.15 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; text-wrap: pretty;">{{ section.settings.t_learning_how_to_style_your_h | escape }}</p>
</li>
</ul></section><section data-screen-label="Barber / Work" style="background: var(--canvas-sunk);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 32px;">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px;">
<div style="display: flex; flex-direction: column; gap: 16px;">
<p class="ba-label">{{ section.settings.t_02_the_work | escape }}</p>
<h2 class="ba-display" style="font-size: clamp(40px, 5vw, 64px);">{{ section.settings.t_elise_s_cuts | escape }}</h2>
</div>
<a class="ba-btn ba-btn-text" href="https://www.instagram.com/broken.arrow.barbershop/">{{ section.settings.t_more_on_instagram | escape }}</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); gap: 4px;">
<div style="position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); display: flex; align-items: flex-end; padding: 14px;">
<div aria-label="Curly hair kept long on top and at the back, with a taper on the sides" role="img" style='position: absolute; inset: 0px; background-image: url("{{ img_elise_cut_a }}"); background-size: cover; background-position: center center;'></div>
</div>
<div style="position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); display: flex; align-items: flex-end; padding: 14px;">
<div aria-label="Medium-length cut combed back, with length kept over the ears" role="img" style='position: absolute; inset: 0px; background-image: url("{{ img_elise_cut_b }}"); background-size: cover; background-position: center center;'></div>
</div>
<div style="position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); display: flex; align-items: flex-end; padding: 14px;">
<div aria-label="Textured cut with a taper at the sides and neckline" role="img" style='position: absolute; inset: 0px; background-image: url("{{ img_elise_cut_c }}"); background-size: cover; background-position: center center;'></div>
</div>
<div style="position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); display: flex; align-items: flex-end; padding: 14px;">
<div aria-label="Flow cut with a taper around the ear and length at the back" role="img" style='position: absolute; inset: 0px; background-image: url("{{ img_elise_cut_d }}"); background-size: cover; background-position: center center;'></div>
</div>
</div>
</div></section><section data-screen-label="Barber / Others" style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 24px;">
