<button aria-pressed="false" data-ba-q="want" data-ba-v="new" style="min-height: 52px; padding: 10px 8px; border: 1px solid var(--line-strong); border-radius: 0px; background: var(--canvas); color: var(--ink); font: 600 12px/16px var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; text-align: center; transition: background-color 150ms, color 150ms;" type="button">{{ section.settings.t_something_new | escape }}</button>
</div>
</div>
<div aria-label="Beard too?" role="group" style="padding: 24px 0px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 16px;">
<p style="font: 800 clamp(18px,2vw,22px)/1.2 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase;">{{ section.settings.t_beard_too | escape }}</p>
<div style="display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0px, 1fr); gap: 8px;">
<button aria-pressed="false" data-ba-q="beard" data-ba-v="yes" style="min-height: 52px; padding: 10px 8px; border: 1px solid var(--line-strong); border-radius: 0px; background: var(--canvas); color: var(--ink); font: 600 12px/16px var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; text-align: center; transition: background-color 150ms, color 150ms;" type="button">{{ section.settings.t_yes_2 | escape }}</button>
<button aria-pressed="false" data-ba-q="beard" data-ba-v="no" style="min-height: 52px; padding: 10px 8px; border: 1px solid var(--line-strong); border-radius: 0px; background: var(--canvas); color: var(--ink); font: 600 12px/16px var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; text-align: center; transition: background-color 150ms, color 150ms;" type="button">{{ section.settings.t_no_2 | escape }}</button>
</div>
</div>
</div>
</div></section>
</div>
