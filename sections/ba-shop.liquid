{%- comment -%} Generated from the Claude Design page "Shop". {%- endcomment -%}
{%- liquid
if section.settings.img_clay_hero != blank
  assign img_clay_hero = section.settings.img_clay_hero | image_url: width: 2400
else
  assign img_clay_hero = 'ba-clay-hero.webp' | asset_url
endif
if section.settings.img_clay_card != blank
  assign img_clay_card = section.settings.img_clay_card | image_url: width: 2400
else
  assign img_clay_card = 'ba-clay-card.webp' | asset_url
endif
if section.settings.img_cream_card != blank
  assign img_cream_card = section.settings.img_cream_card | image_url: width: 2400
else
  assign img_cream_card = 'ba-cream-card.webp' | asset_url
endif
if section.settings.img_salt_card != blank
  assign img_salt_card = section.settings.img_salt_card | image_url: width: 2400
else
  assign img_salt_card = 'ba-salt-card.webp' | asset_url
endif
if section.settings.img_shampoo_card != blank
  assign img_shampoo_card = section.settings.img_shampoo_card | image_url: width: 2400
else
  assign img_shampoo_card = 'ba-shampoo-card.webp' | asset_url
endif
if section.settings.img_conditioner_card != blank
  assign img_conditioner_card = section.settings.img_conditioner_card | image_url: width: 2400
else
  assign img_conditioner_card = 'ba-conditioner-card.webp' | asset_url
endif
if section.settings.img_aftershave_card != blank
  assign img_aftershave_card = section.settings.img_aftershave_card | image_url: width: 2400
else
  assign img_aftershave_card = 'ba-aftershave-card.webp' | asset_url
endif
if section.settings.img_refuge_card != blank
  assign img_refuge_card = section.settings.img_refuge_card | image_url: width: 2400
else
  assign img_refuge_card = 'ba-refuge-card.webp' | asset_url
endif
if section.settings.img_wash_brush != blank
  assign img_wash_brush = section.settings.img_wash_brush | image_url: width: 2400
else
  assign img_wash_brush = 'ba-wash-brush.webp' | asset_url
endif
-%}
<style>
.bah-shop-0:hover { color: var(--green) !important; }
</style>
<div class="ba-page" data-ba-page="shop" data-ba-active="all">
<section data-screen-label="Shop / Hero" style="position: relative; background: var(--band); color: var(--on-band); min-height: clamp(560px, 82vh, 820px); display: flex; align-items: center; overflow: hidden;">
<img alt="Broken Arrow Grooming matte clay jar on a rock with mountains behind" loading="lazy" src="{{ img_clay_hero }}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: 70% center;"/>
<div style="position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(22, 23, 26, 0.88) 0%, rgba(22, 23, 26, 0.6) 38%, rgba(22, 23, 26, 0) 68%);"></div>
<div style="position: relative; width: 100%; max-width: 1280px; margin: 0px auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 5vw, 64px); display: flex; flex-direction: column; gap: 28px;">
<p class="ba-label" style="color: var(--on-band);">{{ section.settings.t_broken_arrow_grooming_first_ | escape }}</p>
<h1 class="ba-display" style="color: var(--on-band); font-size: min(clamp(48px, 7vw, 96px), 11vw); letter-spacing: -0.045em; line-height: 0.92; max-width: 10ch;">{{ section.settings.t_the_clay_we_use_in_the_chair | escape }}</h1>
<p style="max-width: 460px; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.6; opacity: 0.9; text-wrap: pretty;">{{ section.settings.t_matte_clay_firm_hold_no_shin | escape }}</p>
<div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
<a class="ba-btn ba-btn-primary ba-on-dark" href="/products/matte-clay">{{ section.settings.t_see_the_clay | escape }}</a>
</div>
<p class="ba-label" style="color: var(--on-band); opacity: 0.78;">{{ section.settings.t_developed_and_used_at_broken | escape }}</p>
</div></section><section data-screen-label="Shop / Lineup intro" style="background: var(--canvas);">
<div style="max-width: 1280px; margin: 0px auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 5vw, 64px) 32px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px;">
<h2 class="ba-display" style="font-size: clamp(40px, 5vw, 64px);">{{ section.settings.t_the_lineup | escape }}</h2>
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 440px;">
<p style="max-width: 440px; font-size: 17px; line-height: 28px; color: var(--ink-muted); text-wrap: pretty;">{{ section.settings.t_five_products_released_one_a | escape }}</p>
<a class="ba-label" href="/pages/product-quiz" style="color: var(--ink); text-decoration: none; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; min-height: 44px; line-height: 22px;"><span style="color: var(--ink-muted);">{{ section.settings.t_not_sure_which | escape }}</span><span style="border-bottom: 2px solid var(--green); padding-bottom: 2px;">{{ section.settings.t_take_the_30_second_quiz | escape }}</span></a>
</div>
</div></section><section data-screen-label="Shop / Grid" id="shop" style="background: var(--canvas);">
<div style="max-width: 1280px; margin: 0px auto; padding: 0px clamp(16px, 5vw, 64px) clamp(48px, 8vw, 96px); display: flex; flex-direction: column; gap: 32px;">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); padding: 8px 0px;">
<div data-ba-filter="underline" data-ba-filter-hash="grooming" data-ba-filter-scope="" role="tablist" style="display: flex; flex-wrap: wrap; gap: 4px 28px;">
<button aria-selected="true" class="bah-shop-0" data-ba-tab="all" role="tab" style="background: none; border-top: 0px; border-right: 0px; border-bottom: 2px solid var(--green); border-left: 0px; border-image: initial; padding: 0px; min-height: 44px; cursor: pointer; font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);">{{ section.settings.t_all | escape }}</button>
<button aria-selected="false" class="bah-shop-0" data-ba-tab="grooming" role="tab" style="background: none; border-width: 0px 0px 2px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 0px; min-height: 44px; cursor: pointer; font: 600 13px/16px var(--font-sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);">{{ section.settings.t_grooming | escape }}</button>
</div>
</div>
<div data-grid="shop" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 48px 32px;">
<article data-ba-cat="grooming" id="clay" style="display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 140px;">
